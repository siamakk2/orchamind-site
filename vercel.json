{
  "rewrites": [
    {
      "source": "/audit",
      "destination": "/audit.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Deploy-Version",
          "value": "v3-2026-06-27"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/demo.html?app=1",
      "permanent": false
    }
  ]
}
