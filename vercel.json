{
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/app",
      "destination": "/demo.html"
    },
    {
      "source": "/audit",
      "destination": "/audit.html"
    },
    {
      "source": "/proposal",
      "destination": "/proposal.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Deploy-Version",
          "value": "v3-2026-06-27"
        }
      ]
    }
  ]
}